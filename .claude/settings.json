{
  "includeCoAuthoredBy": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync ruff format --quiet",
            "statusMessage": "Formatting with ruff"
          }
        ]
      }
    ]
  }
}
