{
    "project_name": "UV Project",
    "package_name": "{{cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_')}}",
    "author_name": "",
    "github_username": "",
    "project_url": "https://github.com/{{cookiecutter.github_username}}/{{cookiecutter.package_name}}",
    "dependencies": "",
    "dev_dependencies": "",
    "python_version": "3.14",
    "line_length": "100",
    "license": ["MIT", "Apache-2.0", "BSD-3-Clause", "None"],
    "publish_on_pypi": ["No", "Yes"],
    "github_setup": ["None", "private", "internal", "public"],
    "coding_agent": ["None", "Claude", "Codex"],
    "_copy_without_render": [".github/workflows"],
    "__prompts__": {
        "project_name": "Project name",
        "package_name": "Package name",
        "author_name": "Author name",
        "github_username": "GitHub username",
        "project_url": "Repository URL (used for the README badges, and the origin remote unless github_setup creates one)",
        "dependencies": "PyPI dependencies (e.g. numpy scipy==1.14.*)",
        "dev_dependencies": "PyPI dev dependencies (e.g. pytest-xdist>=3.6)",
        "python_version": "Minimum Python version (e.g. 3.14)",
        "line_length": "Line length (80 or greater)",
        "license": "License",
        "publish_on_pypi": "Keep the workflow that publishes to PyPI on a GitHub release",
        "github_setup": "Create the GitHub repository (private, internal, public, or None)",
        "coding_agent": "Coding agent to set up (Claude, Codex, or None)"
    }
}
