{
  "includeCoAuthoredBy": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync ruff format .",
            "statusMessage": "Formatting with ruff"
          },
          {
            "type": "command",
            "command": "uv run --no-sync ruff check . --fix",
            "statusMessage": "Running ruff checks"
          }
        ]
      }
    ]
  }
}
