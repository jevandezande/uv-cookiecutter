{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(prek -a:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(rg:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format .",
            "statusMessage": "Formatting with ruff"
          },
          {
            "type": "command",
            "command": "uv run ruff check . --fix",
            "statusMessage": "Running ruff checks"
          }
        ]
      }
    ]
  }
}
